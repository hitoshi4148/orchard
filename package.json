{
  "name": "orchard",
  "private": true,
  "scripts": {
    "sync:fruit-retail": "tsx scripts/sync-fruit-retail-kajyu.mjs",
    "dev": "wrangler pages dev public --port 8790",
    "deploy": "npm run sync:fruit-retail && wrangler pages deploy public --project-name=orchard --commit-dirty=true",
    "pages:deploy": "wrangler pages deploy public --project-name=orchard --commit-dirty=true",
    "test:marssonina": "tsx --test src/disease/nasa-power-cache.test.ts src/orchard-risk/apple-scab-ascospore-gdd.test.ts src/orchard-risk/marssonina-infection.test.ts src/orchard-risk/marssonina-precip-day.test.ts src/orchard-risk/marssonina-wetness-suzuki.test.ts src/orchard-risk/marssonina-gdd.test.ts src/orchard-risk/marssonina-forecast-risk.test.ts src/orchard-risk/nashi-scab-ishii.test.ts src/orchard-risk/heuristic-disease.test.ts src/orchard-risk/heuristic-onset.test.ts src/orchard-risk/apple-scab-season.test.ts",
    "report:marssonina-phase2": "tsx scripts/marssonina-phase2-compare.ts",
    "test:marssonina:integration": "tsx --test src/orchard-risk/marssonina-infection.integration.test.ts src/orchard-risk/marssonina-phase2-gdd.integration.test.ts",
    "test:orchard-risk": "npm run test:marssonina && npm run test:marssonina:integration",
    "orchard-risk:fetch": "tsx scripts/orchard-risk-cli.ts",
    "report:orchard-risk-validation": "tsx scripts/orchard-risk-validation-report.ts",
    "report:marssonina-phase1": "tsx scripts/marssonina-phase1-compare.ts",
    "deploy:router": "wrangler deploy --config workers/turf-tools-router/wrangler.toml",
    "deploy:fruit-retail-cron": "wrangler deploy --config workers/fruit-retail-cron/wrangler.toml"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250204.0",
    "fflate": "^0.8.2",
    "tsx": "^4.19.4",
    "typescript": "^5.7.3",
    "unpdf": "^1.9.1",
    "wrangler": "^3.109.2"
  }
}
