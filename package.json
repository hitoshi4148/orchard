{
  "name": "orchard",
  "private": true,
  "scripts": {
    "sync:fruit-retail": "tsx scripts/sync-fruit-retail-kajyu.mjs",
    "dev": "wrangler pages dev public --port 8790",
    "deploy": "npm run sync:fruit-retail && wrangler pages deploy public --project-name=orchard --commit-dirty=true",
    "pages:deploy": "wrangler pages deploy public --project-name=orchard --commit-dirty=true",
    "test:marssonina": "tsx --test src/orchard-risk/marssonina-infection.test.ts src/orchard-risk/marssonina-gdd.test.ts",
    "test:marssonina:integration": "tsx --test src/orchard-risk/marssonina-infection.integration.test.ts",
    "deploy:router": "wrangler deploy --config workers/turf-tools-router/wrangler.toml",
    "deploy:fruit-retail-cron": "wrangler deploy --config workers/fruit-retail-cron/wrangler.toml"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250204.0",
    "fflate": "^0.8.2",
    "tsx": "^4.19.4",
    "typescript": "^5.7.3",
    "unpdf": "^1.9.1",
    "wrangler": "^3.109.2"
  }
}
